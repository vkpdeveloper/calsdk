{
  "name": "calsdk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "changeset": "changeset",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "22",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
