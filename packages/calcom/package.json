{
  "name": "@cal-sdk/calcom",
  "version": "0.1.0",
  "description": "Cal.com provider for calsdk: bookings as calendar events.",
  "keywords": [
    "calendar",
    "calendar-api",
    "typescript",
    "calsdk",
    "cal.com",
    "calcom",
    "bookings",
    "scheduling"
  ],
  "license": "MIT",
  "homepage": "https://www.cal-sdk.com",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@cal-sdk/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkpdeveloper/calsdk.git",
    "directory": "packages/calcom"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cal-sdk/provider": "workspace:*",
    "@cal-sdk/provider-utils": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cal-sdk/provider-tests": "workspace:*"
  }
