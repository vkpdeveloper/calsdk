{
  "name": "@cal-sdk/ics",
  "version": "0.0.0",
  "description": "ICS feed provider for calsdk: read subscribed iCalendar feeds.",
  "license": "MIT",
  "homepage": "https://www.cal-sdk.com",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@cal-sdk/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icalendar": {
      "@cal-sdk/source": "./src/icalendar.ts",
      "types": "./dist/icalendar.d.ts",
      "default": "./dist/icalendar.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkpdeveloper/calsdk.git",
    "directory": "packages/ics"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cal-sdk/provider": "workspace:*",
    "@cal-sdk/provider-utils": "workspace:*",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  }
}
